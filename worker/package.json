    "vectorize:upload": "node scripts/upload-to-vectorize.mjs",
    "secret:minimax": "wrangler secret put MINIMAX_API_KEY"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.95.0"
  }
}
