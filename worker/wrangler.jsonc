{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atlas-chat",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-01",
  "observability": { "enabled": true },

  // Non-secret config.
  "vars": {
    "MINIMAX_URL": "https://api.minimax.io/v1/text/chatcompletion_v2",
    "MINIMAX_MODEL": "MiniMax-M3.1-Flash",
    "EMBED_DIM": "384",
    "MIN_SIM": "0.75",
    "DAILY_CAP": "500",
    "ALLOWED_ORIGINS": "https://efloresp06.github.io,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,http://localhost:5178"
  },

  // Vectorize. Create first: npm run vectorize:create
  "vectorize": [
    { "binding": "VECTORIZE", "index_name": "atlas-chunks" }
  ],

  // KV for daily counter. Create: wrangler kv namespace create ATLAS_KV
  "kv_namespaces": [
    { "binding": "KV", "id": "a10ae85387c14710a1fa81e3afdda8dd" }
  ],

  // Per-IP rate limit, free tier binding.
  "unsafe": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 20, "period": 60 }
      }
    ]
  }

  // Secrets (NOT here — set with wrangler):
  //   npm run secret:minimax
}
